{
  "name": "HHSL Command",
  "short_name": "HHSL Command",
  "description": "HHSL Safety Systems Limited: rosters, crews, ER Log, staff and compliance",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b2a3c",
  "theme_color": "#14506B",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://hhslsafety-command.netlify.app/manifest.webmanifest"
    }
  ],
  "prefer_related_applications": false
}
